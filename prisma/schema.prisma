// Ikrar Kita - Prisma schema
//
// Conventions:
//   - All ids are CUIDs for URL safety + sortability.
//   - Timestamps use @default(now()) and @updatedAt where appropriate.
//   - Soft deletion is NOT used. Invitation has an ARCHIVED status instead.
//   - JSONB columns are used for raw provider payloads + invitation content.
//
// Network access:
//   - DATABASE_URL is read from env. Connection pooling is handled by the
//     Postgres container. We do not configure a separate pgbouncer here.

generator client {
  provider = "prisma-client-js"
  output = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}


// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum EmailVerificationStatus {
  UNVERIFIED
  VERIFIED
}

enum PlanCode {
  BASIC
  PRO
  RESELLER
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum InvoiceStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  CANCELLED
  REFUND
}

enum PaymentProvider {
  TRIPAY
  MANUAL
}

enum InvitationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum InvitationMediaType {
  COVER
  GALLERY
  MUSIC
}

enum RsvpAttendance {
  YES
  NO
  MAYBE
}

enum EmailEventType {
  VERIFICATION
  VERIFICATION_SUCCESS
  INVOICE_CREATED_USER
  INVOICE_CREATED_ADMIN
  INVOICE_PAID_USER
  INVOICE_PAID_ADMIN
  INVOICE_EXPIRED_USER
  INVOICE_FAILED_USER
  PASSWORD_RESET
}

enum EmailEventStatus {
  SENT
  FAILED
  QUEUED
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id                      String                  @id @default(cuid())
  name                    String
  email                   String                  @unique
  passwordHash            String
  role                    Role                    @default(USER)
  emailVerifiedAt         DateTime?
  emailVerificationStatus EmailVerificationStatus @default(UNVERIFIED)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  sessions                Session[]
  invitations             Invitation[]
  subscriptions           Subscription[]
  invoices                Invoice[]
  emailVerificationTokens EmailVerificationToken[]
  emailEvents             EmailEvent[]
  auditLogs               AuditLog[]               @relation("AuditUser")
  adminAuditLogs          AuditLog[]               @relation("AuditAdmin")
  approvedInvoices        Invoice[]                @relation("InvoiceApprovedBy")

  @@index([role])
  @@index([emailVerificationStatus])
}

// Session is a server-side session record. Cookie carries an opaque token
// hash so we can revoke individual sessions and rotate without invalidating
// every login.
model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailEvent {
  id           String           @id @default(cuid())
  userId       String?
  invoiceId    String?
  type         EmailEventType
  recipient    String
  status       EmailEventStatus
  provider     String           @default("GMAIL_SMTP")
  errorMessage String?
  createdAt    DateTime         @default(now())

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([invoiceId])
  @@index([type, status])
  @@index([createdAt])
}

model Plan {
  id              String   @id @default(cuid())
  code            PlanCode @unique
  name            String
  price           Int // amount in IDR (no decimals)
  durationDays    Int // 30 for all current plans
  invitationLimit Int? // null = unlimited (RESELLER)
  description     String?
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subscriptions Subscription[]
  invoices      Invoice[]
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String
  planId    String
  status    SubscriptionStatus @default(PENDING)
  startsAt  DateTime
  expiresAt DateTime
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([userId, status])
  @@index([expiresAt])
}

model Invoice {
  id              String          @id @default(cuid())
  userId          String
  planId          String
  amount          Int
  status          InvoiceStatus   @default(PENDING)
  paymentProvider PaymentProvider @default(TRIPAY)

  // Tripay specific - all nullable until checkout completes
  paymentMethodCode     String?
  paymentMethodName     String?
  merchantRef           String  @unique
  tripayReference       String? @unique
  tripayCheckoutUrl     String?
  tripayPayCode         String?
  tripayQrUrl           String?
  tripayRawResponse     Json?
  tripayCallbackPayload Json?

  expiredAt          DateTime?
  paidAt             DateTime?
  approvedAt         DateTime?
  approvedByAdminId  String?
  manualApprovalNote String?
  processedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan            Plan           @relation(fields: [planId], references: [id])
  approvedByAdmin User?          @relation("InvoiceApprovedBy", fields: [approvedByAdminId], references: [id])
  paymentEvents   PaymentEvent[]
  emailEvents     EmailEvent[]

  @@index([userId])
  @@index([status])
  @@index([userId, status])
  @@index([createdAt])
}

model PaymentEvent {
  id               String          @id @default(cuid())
  invoiceId        String?
  provider         PaymentProvider
  eventType        String // e.g. "payment_status", "callback_invalid"
  status           String // raw provider status (PAID, FAILED, etc.)
  rawPayload       Json
  signature        String?
  isValidSignature Boolean         @default(false)
  createdAt        DateTime        @default(now())

  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([provider, eventType])
  @@index([createdAt])
}

model Invitation {
  id     String           @id @default(cuid())
  userId String
  slug   String           @unique
  status InvitationStatus @default(DRAFT)
  title  String?

  // Couple
  groomName String
  brideName String

  // Event basics - kept on top-level columns for indexing/listing
  eventDate    DateTime?
  venueName    String?
  venueAddress String?
  latitude     Float?
  longitude    Float?

  // Visual
  theme         String  @default("classic-elegant")
  primaryColor  String?
  coverImageUrl String?
  musicUrl      String?

  // Full content blob - parents, story, schedule, gifts, custom sections, etc.
  // Validated at the application layer with Zod (see lib/validators/invitation.ts).
  content Json @default("{}")

  publishedAt DateTime?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  media         InvitationMedia[]
  rsvps         Rsvp[]
  guestMessages GuestMessage[]
  guests        Guest[]

  @@index([userId])
  @@index([userId, status])
  @@index([status, publishedAt])
}

model InvitationMedia {
  id           String              @id @default(cuid())
  invitationId String
  type         InvitationMediaType
  url          String
  filename     String
  mimeType     String
  size         Int // bytes
  width        Int?
  height       Int?
  durationMs   Int?
  createdAt    DateTime            @default(now())

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
  @@index([invitationId, type])
}

model Rsvp {
  id               String         @id @default(cuid())
  invitationId     String
  guestName        String
  attendanceStatus RsvpAttendance
  guestCount       Int            @default(1)
  message          String?
  ipHash           String? // sha256(ip + salt) for soft rate limit / dedupe
  createdAt        DateTime       @default(now())

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
  @@index([invitationId, attendanceStatus])
}

model GuestMessage {
  id           String   @id @default(cuid())
  invitationId String
  name         String
  message      String
  isApproved   Boolean  @default(true)
  ipHash       String?
  createdAt    DateTime @default(now())

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
  @@index([invitationId, isApproved])
}

model Guest {
  id           String   @id @default(cuid())
  invitationId String
  name         String
  phone        String?
  customToken  String?  @unique
  createdAt    DateTime @default(now())

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  adminId    String?
  action     String // e.g. "invitation.publish", "invoice.manual_approve"
  entityType String // e.g. "Invitation", "Invoice", "User"
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user  User? @relation("AuditUser", fields: [userId], references: [id], onDelete: SetNull)
  admin User? @relation("AuditAdmin", fields: [adminId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([entityType, entityId])
  @@index([userId])
  @@index([adminId])
  @@index([createdAt])
}
