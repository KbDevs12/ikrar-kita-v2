# ─────────────────────────────────────────────────────────────────────────────
# Ikrar Kita - Environment configuration
#
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
COOKIE_DOMAIN=

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# When running Next.js on the host with `pnpm dev` and Postgres in Docker,
# use localhost. When the app runs inside Docker, use `postgres` (service name).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wedding_saas
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=wedding_saas
POSTGRES_PORT=5432

# ── Redis ────────────────────────────────────────────────────────────────────
# Format: redis://[:password@]host:port
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_MAXMEMORY=256mb

# ── Session / Auth ───────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
SESSION_SECRET=change-me-with-openssl-rand-base64-48-chars-long-string

# ── Internal API security (server-only, never NEXT_PUBLIC_) ──────────────────
# Generate each with: openssl rand -hex 32
INTERNAL_API_KEY=change-me-internal-32-bytes-hex
CRON_SECRET=change-me-cron-32-bytes-hex
ADMIN_API_KEY=

# ── Tripay payment gateway ───────────────────────────────────────────────────
# Get sandbox credentials from https://tripay.co.id (sandbox merchant)
TRIPAY_MODE=sandbox
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_MERCHANT_CODE=
TRIPAY_CALLBACK_URL=http://localhost:3000/api/webhooks/tripay
TRIPAY_RETURN_URL=http://localhost:3000/dashboard/billing

# ── MinIO (object storage) ───────────────────────────────────────────────────
# MINIO_ENDPOINT is used server-side for uploads (internal hostname).
# MINIO_PUBLIC_URL is the URL used in <img src=...> for browsers.
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-this-minio-password
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-this-minio-password
MINIO_BUCKET=wedding-media
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BROWSER_REDIRECT_URL=http://localhost:9001

# ── Email / Gmail SMTP ───────────────────────────────────────────────────────
# Use a Google Workspace account or a Gmail account with an App Password.
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME="Ikrar Kita"
SMTP_FROM_EMAIL=
ADMIN_NOTIFICATION_EMAIL=

# Email verification
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=60
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60

# ── Nginx (only used by docker compose) ──────────────────────────────────────
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443

# ── Seed data ────────────────────────────────────────────────────────────────
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-this-password
